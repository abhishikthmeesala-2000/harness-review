+import stripe from '../lib/stripe.js';
+
+export async function chargeCustomer(
+  customerId: string,
+  amountCents: number,
+): Promise<string> {
+  const payment = await stripe.paymentIntents.create({
+    amount: amountCents,
+    currency: 'usd',
+    customer: customerId,
+  });
+  return payment.id;
+}
