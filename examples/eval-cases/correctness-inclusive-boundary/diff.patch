new file mode 100644
--- /dev/null
+++ b/src/utils/range.ts
@@ -0,0 +1,9 @@
+// inclusive by design: end is part of the contract
+export function inclusiveRange(start: number, end: number): number[] {
+  const result: number[] = [];
+  for (let i = start; i <= end; i++) {
+    result.push(i);
+  }
+  return result;
+}
